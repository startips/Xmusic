<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bg_widget_card"
  android:orientation="vertical"
  android:padding="13dp">

  <!-- Top Row: Vinyl Cover + Title/Artist + Favorite Heart -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/widget_cover"
      android:layout_width="54dp"
      android:layout_height="54dp"
      android:scaleType="centerCrop"
      android:src="@drawable/ic_widget_disc"
      android:contentDescription="@string/app_name" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="11dp"
      android:layout_marginEnd="8dp"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="XMUSIC · M3"
        android:textColor="#88FFFFFF"
        android:textSize="9.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Xmusic"
        android:textColor="#F5FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="随时聆听好音乐"
        android:textColor="#A8FFFFFF"
        android:textSize="11.5sp" />
    </LinearLayout>

    <ImageButton
      android:id="@+id/widget_btn_fav"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="@drawable/bg_widget_btn_tonal"
      android:padding="8dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_media_favorite_off"
      android:contentDescription="Favorite" />
  </LinearLayout>

  <!-- Middle Row: Live Lyric Pill -->
  <TextView
    android:id="@+id/widget_lyric"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_widget_lyric_pill"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:text="♪ 轻触播放，实时同步桌面歌词"
    android:textColor="#E64DAF7C"
    android:textSize="12.5sp"
    android:textStyle="bold" />

  <!-- Bottom Row: Transport Controls -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
      android:id="@+id/widget_btn_prev"
      android:layout_width="44dp"
      android:layout_height="34dp"
      android:background="@drawable/bg_widget_btn_tonal"
      android:padding="7dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_prev"
      android:contentDescription="Previous" />

    <FrameLayout
      android:id="@+id/widget_btn_play_wrap"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:layout_marginStart="8dp"
      android:layout_marginEnd="8dp">

      <ImageView
        android:id="@+id/widget_btn_play_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_widget_btn_primary"
        android:scaleType="fitXY" />

      <ImageView
        android:id="@+id/widget_btn_play_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_widget_play"
        android:scaleType="fitCenter" />
    </FrameLayout>

    <ImageButton
      android:id="@+id/widget_btn_next"
      android:layout_width="44dp"
      android:layout_height="34dp"
      android:background="@drawable/bg_widget_btn_tonal"
      android:padding="7dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_next"
      android:contentDescription="Next" />
  </LinearLayout>
</LinearLayout>
